# =============================================================================
# basyx-setup — environment configuration
# =============================================================================
# Copy this file to `.env` (which is gitignored) and adjust values as needed.
# All values below have working defaults for a local, single-machine prototype
# — you can `docker compose up -d` with an unedited `.env` and it will work.
#
#   cp .env.example .env
#
# NOTE: docker-compose.yml also has ${VAR:-default} fallbacks baked in, so this
# file is optional for docker compose itself — but simulator/simulate.py reads
# these at runtime (via docker-compose's `environment:` passthrough), so the
# simulator container needs the MQTT_* vars to be defined somewhere.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (semantic/asset data plane: AAS shells, submodels, registry)
# -----------------------------------------------------------------------------
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=basyxTestDB
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_MAXOPENCONNECTIONS=500
POSTGRES_MAXIDLECONNECTIONS=500
POSTGRES_CONNMAXLIFETIMEMINUTES=5

# -----------------------------------------------------------------------------
# InfluxDB (time-series telemetry plane)
# -----------------------------------------------------------------------------
# The token below is a local-only development default, provided so the stack
# runs out of the box. Generate your own with `openssl rand -base64 44` before
# using this stack for anything beyond a local prototype.
INFLUXDB_TOKEN=T8s57FEsJmZET/m0wAIB1ELo989hUzRJg2DGIa5zBiE0u3xroDCl6GX4amg=
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=influxpassword
INFLUXDB_ORG=basyx
INFLUXDB_BUCKET=wind_turbine
INFLUXDB_HOST=influxdb
INFLUXDB_PORT=8086
# Endpoint as seen by the browser running the aas-gui UI (localhost, since the
# UI's Flux query runs client-side against the published port).
INFLUXDB_PUBLIC_ENDPOINT=http://localhost:8086

# -----------------------------------------------------------------------------
# MQTT / Mosquitto broker
# -----------------------------------------------------------------------------
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=WindTurbine/Telemetry

# -----------------------------------------------------------------------------
# Simulator
# -----------------------------------------------------------------------------
SIMULATOR_INTERVAL_SECONDS=1

# -----------------------------------------------------------------------------
# Telegraf (MQTT -> InfluxDB bridge)
# -----------------------------------------------------------------------------
TELEGRAF_INTERVAL=1s
TELEGRAF_FLUSH_INTERVAL=10s
TELEGRAF_BATCH_SIZE=1000
TELEGRAF_BUFFER_LIMIT=10000
TELEGRAF_MEASUREMENT=wind_turbine_metric

# -----------------------------------------------------------------------------
# aas-environment / aas-gui
# -----------------------------------------------------------------------------
AAS_ENVIRONMENT_PORT=8082
AAS_GUI_PORT=3000
AAS_EXTERNAL_URL=http://localhost:8082
